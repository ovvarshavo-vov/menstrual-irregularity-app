* {
  box-sizing: border-box;
}

:root {
  --bg-a: #fdf2f7;
  --bg-b: #f7f0ff;
  --bg-c: #fff9f1;
  --text-strong: #422c4c;
  --text-soft: #725c78;
  --pink-1: #f9c7d6;
  --pink-2: #f7a7c0;
  --pink-3: #f5d6e7;
  --lavender: #d7cbff;
  --peach: #fce7d7;
  --white: #ffffff;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  min-height: 100vh;
  font-family: 'Plus Jakarta Sans', sans-serif;
  background: linear-gradient(135deg, var(--bg-a), var(--bg-b) 45%, var(--bg-c));
  color: var(--text-strong);
}

body {
  min-height: 100vh;
}

button {
  font: inherit;
}

.page-shell {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 24px;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(2px);
  opacity: 0.6;
}

.orb-one {
  width: 440px;
  height: 440px;
  background: rgba(250, 205, 220, 0.4);
  top: -110px;
  left: -80px;
}

.orb-two {
  width: 520px;
  height: 520px;
  background: rgba(214, 210, 255, 0.35);
  right: -120px;
  bottom: -80px;
}

.orb-three {
  width: 260px;
  height: 260px;
  background: rgba(255, 236, 201, 0.45);
  left: 52%;
  top: 12%;
}

.hero-section {
  position: relative;
  z-index: 1;
  width: min(1200px, 100%);
  display: grid;
  grid-template-columns: 1.02fr 0.98fr;
  align-items: center;
  gap: 28px;
}

.content-panel {
  padding: 20px 12px 20px 16px;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  margin: 0 0 18px;
  padding: 8px 14px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.64);
  color: var(--text-soft);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  box-shadow: 0 12px 24px rgba(110, 78, 97, 0.06);
}

h1 {
  margin: 0;
  font-size: clamp(3.1rem, 5vw, 6rem);
  line-height: 0.93;
  letter-spacing: -0.08em;
  font-weight: 800;
}

.subtitle {
  max-width: 560px;
  margin: 20px 0 0;
  color: var(--text-soft);
  font-size: clamp(1rem, 1.6vw, 1.3rem);
  line-height: 1.7;
}

.cta-button {
  margin-top: 30px;
  border: none;
  border-radius: 999px;
  background: linear-gradient(135deg, #f39fbb, #d7b7ff);
  color: var(--white);
  font-size: 1.02rem;
  font-weight: 700;
  padding: 18px 32px;
  box-shadow: 0 18px 42px rgba(226, 142, 182, 0.38);
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.cta-button:hover {
  transform: translateY(-2px) scale(1.01);
  box-shadow: 0 22px 50px rgba(226, 142, 182, 0.46);
}

.mini-stats {
  margin-top: 34px;
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
}

.mini-stats div {
  min-width: 132px;
  background: rgba(255, 255, 255, 0.4);
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: 22px;
  padding: 16px 18px;
  backdrop-filter: blur(10px);
  display: flex;
  flex-direction: column;
  gap: 6px;
  box-shadow: 0 18px 30px rgba(108, 79, 100, 0.06);
}

.mini-stats strong {
  font-size: 1.2rem;
  font-weight: 800;
}

.mini-stats span {
  font-size: 0.78rem;
  color: var(--text-soft);
}

.visual-panel {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 26px;
}

.floating-card {
  position: relative;
  width: min(100%, 540px);
  min-height: 560px;
  padding: 26px 20px 18px;
  border-radius: 38px;
  background: rgba(255, 255, 255, 0.42);
  border: 1px solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 28px 50px rgba(126, 90, 115, 0.13);
  backdrop-filter: blur(16px);
}

.card-tag {
  position: absolute;
  top: 18px;
  right: 22px;
  z-index: 2;
  background: rgba(255, 255, 255, 0.7);
  color: var(--text-strong);
  border-radius: 999px;
  padding: 9px 14px;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.pad-illustration {
  display: block;
  width: 100%;
  height: auto;
  margin-top: 40px;
}

@media (max-width: 880px) {
  .hero-section {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .content-panel {
    padding: 10px 6px;
  }

  .subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .mini-stats {
    justify-content: center;
  }

  .visual-panel {
    padding-top: 0;
  }
}

@media (max-width: 480px) {
  .page-shell {
    padding: 28px 18px;
  }

  .floating-card {
    min-height: 420px;
  }

  h1 {
    letter-spacing: -0.06em;
  }

  .cta-button {
    width: 100%;
  }
}
